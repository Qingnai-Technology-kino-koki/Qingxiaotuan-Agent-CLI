#!/usr/bin/env node
/**
 * 青小团 CLI npm 包装器
 * 
 * 通过 npm 全局安装后, 此脚本作为 qxt 命令的入口:
 *   npm install -g qingxiaotuan
 *   qxt chat
 * 
 * 工作流程:
 * 1. 检测 Python 环境 (系统 Python 或 venv)
 * 2. 确保 qingxiaotuan 包已安装 (pip install)
 * 3. 转发所有参数给真正的 Python CLI
 */

'use strict';

const { execSync, spawn } = require('child_process');
const path = require('path');
const fs = require('fs');

// 项目根目录 (npm 安装时的包目录)
const PKG_ROOT = path.resolve(__dirname, '..');

// Python 可执行文件路径
let pythonCmd = null;

/**
 * 查找可用的 Python 解释器
 */
function findPython() {
  const candidates = ['python3', 'python', 'py'];
  for (const cmd of candidates) {
    try {
      const version = execSync(`${cmd} --version`, { 
        encoding: 'utf-8', 
        timeout: 5000,
        stdio: ['pipe', 'pipe', 'pipe']
      });
      if (version.includes('Python 3.')) {
        return cmd;
      }
    } catch (e) {
      // 继续尝试下一个
    }
  }
  return null;
}

/**
 * 确保 Python 包已安装
 */
function ensureInstalled(python) {
  const eggInfo = path.join(PKG_ROOT, 'qingxiaotuan.egg-info');
  if (!fs.existsSync(eggInfo)) {
    console.log('🔧 首次运行, 正在安装青小团 Python 依赖...');
    try {
      execSync(`${python} -m pip install -e "${PKG_ROOT}" -q`, {
        stdio: 'inherit',
        timeout: 120000,
        cwd: PKG_ROOT,
      });
      console.log('✅ 安装完成');
    } catch (e) {
      console.error('❌ 安装失败, 请手动运行: pip install -e .');
      process.exit(1);
    }
  }
}

/**
 * 启动 qxt CLI
 */
function main() {
  // 查找 Python
  pythonCmd = findPython();
  if (!pythonCmd) {
    console.error('❌ 未找到 Python 3, 请安装 Python 3.11+ 后重试');
    console.error('   下载: https://www.python.org/downloads/');
    process.exit(1);
  }

  // 确保已安装
  ensureInstalled(pythonCmd);

  // 转发参数给 Python CLI
  const args = process.argv.slice(2);
  const child = spawn(pythonCmd, ['-m', 'qingxiaotuan.cli', ...args], {
    stdio: 'inherit',
    cwd: process.cwd(),
    env: process.env,
  });

  child.on('close', (code) => {
    process.exit(code || 0);
  });

  child.on('error', (err) => {
    console.error(`❌ 启动失败: ${err.message}`);
    process.exit(1);
  });
}

main();
