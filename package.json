{
  "name": "qingxiaotuan",
  "version": "0.2.0",
  "description": "青小团 CLI - 以最小影响半径为核心理念的 Agent CLI，纯 Python 全栈",
  "bin": {
    "qxt": "bin/qxt"
  },
  "scripts": {
    "postinstall": "node scripts/install.js",
