    "cli",
    "ai",
    "coding-assistant",
    "safety",
    "python",
    "qingxiaotuan",
    "青小团"
  ],
  "author": "Qingnai Technology",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "bin/",
    "scripts/",
    "qingxiaotuan/",
    "pyproject.toml",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
